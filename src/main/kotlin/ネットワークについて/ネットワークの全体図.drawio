        </mxCell>
        <mxCell id="01_e_fxqBLR3VYLmdFnX-25" value="com、jp、orgなどの&lt;br&gt;トップレベルドメインのDNSサーバー" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="362" y="330" width="130" height="40" as="geometry" />
        </mxCell>
        <mxCell id="01_e_fxqBLR3VYLmdFnX-26" value="" style="endArrow=classic;html=1;rounded=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="01_e_fxqBLR3VYLmdFnX-25" target="01_e_fxqBLR3VYLmdFnX-6">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="330" y="370" as="sourcePoint" />

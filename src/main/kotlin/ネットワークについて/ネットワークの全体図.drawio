          </mxGeometry>
        </mxCell>
        <mxCell id="01_e_fxqBLR3VYLmdFnX-28" value="" style="endArrow=classic;html=1;rounded=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;exitX=0.5;exitY=0;exitDx=0;exitDy=0;" edge="1" parent="1" source="01_e_fxqBLR3VYLmdFnX-13" target="01_e_fxqBLR3VYLmdFnX-3">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="330" y="380" as="sourcePoint" />
            <mxPoint x="380" y="330" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="01_e_fxqBLR3VYLmdFnX-29" value="&lt;font style=&quot;font-size: 10px;&quot;&gt;認証局はサーバーが本物であると署名した証明書を発行して、サーバーが証明書を保持している&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="840" y="310" width="130" height="30" as="geometry" />
        </mxCell>
        <mxCell id="01_e_fxqBLR3VYLmdFnX-30" value="&lt;font style=&quot;font-size: 10px;&quot;&gt;補足：DNSやTCP、TLSの接続後はキャッシュなどを一定期間持ち通信の度にすべての工程を行わなくてもよくしている&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="200" y="80" width="630" height="20" as="geometry" />
        </mxCell>
